{"id":"main","name":"Spotlight crowd","duration":8,"background":"$bg",
 "camera":{"expr":"var k = smoothstep(0, d, T); return {position:[760 + 90*k, -70 + 55*k, -420 + 150*k], target:[1100, 830, 1500], fov:36, dof:{focus:1750 - 150*k, blur:8, range:0.45}, shake:[{at:3.2, y:9, roll:0.4}]};"},
 "fog":{"color":"$bg","near":1500,"far":3400},
 "post":{"exposure":0.1,"tonemap":true,"bloom":{"intensity":0.5,"threshold":1},"vignette":{"amount":0.7,"softness":0.8},"grain":0.05,"motionBlur":{"samples":3,"shutter":0.5},"fade":{"in":0.5,"out":0.6}},
 "nodes":[
  {"id":"crowd","type":"repeater","x":1000,"y":830,"z":1500,"rotationY":16,
   "layout":"grid","cols":34,"rows":28,"spacing":86,"jitter":0.3,"seed":11,"color":"$muted",
   "items":[{"symbol":"basic/person","height":92,"weight":50},{"symbol":"basic/person","height":100,"widthScale":0.88,"weight":28},
            {"symbol":"basic/people","height":96,"weight":14},{"symbol":"basic/person","height":84,"widthScale":1.1,"weight":8}],
   "instance":{"lit":{"expr":"var r = pick(i, n, 0.38, 7); if (r < 0) return 0; var L = t - 3.2; return lamp(t, 1.0 + 2.4*Math.sqrt((r+1)/Math.round(n*0.38))) * (L > 0 ? 1 + 0.4*Math.exp(-L*4) : 1);"},
               "scale":{"expr":"0.9 + rand(i*5.3)*0.2"},
               "color":{"expr":"var r = pick(i, n, 0.38, 7); return (r >= 0 && t > 1.0 + 2.4*Math.sqrt((r+1)/Math.round(n*0.38))) ? '$accent' : '$muted';"}},
   "rim":0.8,"rimColor":"$pool",
   "ground":{"color":"$floor","checker":false},
   "ambient":{"intensity":0.05,"grow":0.1,"color":"$accent"},
   "pool":{"radius":36,"color":"$pool","intensity":1.4,"softness":0.35,"spill":{"radius":3.2,"intensity":0.14}},
   "contact":{"opacity":0.85},"shadow":{"opacity":0.7,"length":0.5,"angle":20},
   "cone":{"intensity":0.45,"color":"$pool"},"beam":{"intensity":0.08,"color":"$pool","height":800,"width":120}},
  {"id":"shade","type":"shape","x":960,"y":540,"width":1920,"height":1080,
   "fill":{"linear":[-960,-540,500,340],"stops":[[0,"$ink@90"],[0.55,"$ink@44"],[1,"$ink@0"]]}},
  {"id":"counter","type":"text","text":"{v}%","font":"$display","size":300,"color":"$fg","x":104,"y":90,"tabular":true,
   "value":{"expr":"Math.min(38, Math.ceil(38 * litCount('crowd') / Math.max(1, Math.round(instanceCount('crowd') * 0.38))))"}},
  {"id":"rule","type":"shape","shape":"line","x":108,"y":440,"to":[160,0],"stroke":"$accent","strokeWidth":6,"in":4.4,
   "trim":{"k":[[0,[0,0]],[0.7,[0,1],"outExpo"]]}},
  {"id":"caption","type":"text","in":4.5,"text":"of commuters now\ncycle to work","font":"$body","size":64,"color":"$fg","uppercase":true,"tracking":2,"lineHeight":1.1,"x":106,"y":480,
   "reveal":{"by":"line","stagger":0.14,"duration":0.8,"ease":"outExpo","mask":true,"from":{"opacity":0,"y":70}}}
 ]}
