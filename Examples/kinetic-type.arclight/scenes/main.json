{
  "id": "main",
  "name": "Make it move",
  "duration": 7.2,
  "background": "$bg",
  "post": {"grain": 0.05, "fade": {"in": 0.25, "out": 0.4, "color": "$bg"}},
  "nodes": [
    {"id": "b1", "type": "text", "name": "Beat 1", "in": 0, "out": 1.95,
     "text": "MAKE IT\nMOVE.", "font": "$display", "size": 440, "color": "$fg", "align": "left",
     "x": 120, "y": 150, "tracking": -6, "lineHeight": 0.92,
     "reveal": {"by": "char", "stagger": 0.06, "duration": 0.7, "order": "center", "ease": "outExpo",
                "from": {"opacity": 0, "x": 0, "y": 0, "skew": -35, "scale": 1.0}}},
    {"id": "b1-rule", "type": "shape", "shape": "line", "name": "Beat 1 rule", "in": 0.2, "out": 1.95,
     "x": 120, "y": 1000, "to": [1680, 0], "stroke": "$fg", "strokeWidth": 14,
     "trim": {"k": [[0, [0, 0]], [1.1, [0, 1], "inOutCubic"]]}},

    {"id": "slabA", "type": "shape", "shape": "rect", "name": "Slab A (black, wipes from left)", "in": 1.7,
     "x": 0, "y": 540, "width": 1920, "height": 1080, "fill": "$fg", "anchor": [-960, 0],
     "scale": {"k": [[0, [0, 1]], [0.5, [1, 1], [0.8, 0, 0.1, 1]]]}},
    {"id": "b2", "type": "text", "name": "Beat 2", "in": 2.05, "out": 3.75,
