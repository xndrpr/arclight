     "reveal": {"by": "line", "stagger": 0.16, "duration": 0.8, "mask": true, "ease": "outExpo",
                "from": {"opacity": 1, "y": 420}}},
    {"id": "b2-tag", "type": "text", "name": "Beat 2 tag", "in": 2.3, "out": 3.75,
     "text": "NOTHING FADES. EVERYTHING ARRIVES.", "font": "$body", "size": 40, "color": "$bg", "align": "left",
     "x": 126, "y": 960, "tracking": 4,
     "reveal": {"by": "char", "stagger": 0.01, "duration": 0.3, "ease": "outExpo", "from": {"opacity": 0, "y": 20}}},

    {"id": "slabB", "type": "shape", "shape": "rect", "name": "Slab B (white, wipes up)", "in": 3.55,
