     "reveal": {"by": "line", "duration": 0.6, "mask": true, "ease": "outBack", "from": {"opacity": 1, "y": 130}}},
    {"id": "b3-s1", "type": "text", "name": "Beat 3 side 2", "in": 4.50, "out": 5.35,
     "text": "NO FLUFF.", "font": "$display", "size": 110, "color": "$fg", "align": "left",
     "x": 1260, "y": 575, "tracking": 0,
     "reveal": {"by": "line", "duration": 0.6, "mask": true, "ease": "outBack", "from": {"opacity": 1, "y": 130}}},
    {"id": "b3-s2", "type": "text", "name": "Beat 3 side 3", "in": 4.70, "out": 5.35,
     "text": "NO FADE.", "font": "$display", "size": 110, "color": "$fg", "align": "left",
     "x": 1260, "y": 872, "tracking": 0,
     "reveal": {"by": "line", "duration": 0.6, "mask": true, "ease": "outBack", "from": {"opacity": 1, "y": 130}}},
    {"id": "slabC", "type": "shape", "shape": "rect", "name": "Slab C (red, wipes from right)", "in": 5.15,
     "x": 1920, "y": 540, "width": 1920, "height": 1080, "fill": "$bg", "anchor": [960, 0],
     "scale": {"k": [[0, [0, 1]], [0.5, [1, 1], [0.8, 0, 0.1, 1]]]}},
    {"id": "h1", "type": "text", "name": "Hero line 1", "in": 5.6,
     "text": "MAKE IT", "font": "$display", "size": 270, "color": "$fg", "align": "left",
     "x": 120, "y": 120, "tracking": -4,
     "reveal": {"by": "line", "duration": 0.8, "mask": true, "ease": "outExpo", "from": {"opacity": 1, "y": 300}}},
    {"id": "h2", "type": "text", "name": "Hero line 2", "in": 5.75,
     "text": "MOVE.", "font": "$display", "size": 640, "color": "$accent", "align": "left",
     "x": 112, "y": 400, "tracking": -5,
     "reveal": {"by": "char", "stagger": 0.07, "duration": 0.9, "order": "reverse", "ease": "spring",
                "from": {"opacity": 0, "y": 160, "scale": 0.85, "skew": 0}}},
    {"id": "h-tag", "type": "text", "name": "Hero caption", "in": 6.3,
     "text": "A SHORT MANIFESTO\nFOR TYPE IN MOTION", "font": "$body", "size": 38, "color": "$fg", "align": "right",
     "x": 1800, "y": 140, "tracking": 3, "lineHeight": 1.3,
     "reveal": {"by": "line", "stagger": 0.12, "duration": 0.6, "mask": true, "ease": "outExpo", "from": {"opacity": 1, "y": 60}}},
    {"id": "h-rule", "type": "shape", "shape": "line", "name": "Hero rule", "in": 6.05,
     "x": 120, "y": 1010, "to": [1680, 0], "stroke": "$fg", "strokeWidth": 14,
     "trim": {"k": [[0, [0, 0]], [0.8, [0, 1], "outExpo"]]}}
  ]
}
